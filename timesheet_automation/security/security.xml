<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Record rule for standard users: See only their own timesheets -->
        <record id="rule_employee_monthly_timesheet_user" model="ir.rule">
            <field name="name">Employee Monthly Timesheet: Own Records</field>
            <field name="model_id" ref="model_employee_monthly_timesheet"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Record rule for managers: See all timesheets -->
        <record id="rule_employee_monthly_timesheet_manager" model="ir.rule">
            <field name="name">Employee Monthly Timesheet: All Records</field>
            <field name="model_id" ref="model_employee_monthly_timesheet"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr_timesheet.group_timesheet_manager')), (4, ref('hr.group_hr_manager'))]"/>
        </record>
    </data>
</odoo>
