<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_employee_monthly_timesheet_form" model="ir.ui.view">
        <field name="name">employee.monthly.timesheet.form</field>
        <field name="model">employee.monthly.timesheet</field>
        <field name="arch" type="xml">
            <form string="Monthly Timesheet">
                <header>
                    <button name="action_generate_days" string="Generate Days" type="object" class="oe_highlight" states="draft" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" states="draft" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" states="submitted" groups="hr_timesheet.group_timesheet_manager,hr.group_hr_manager" attrs="{'invisible': [('state', '!=', 'submitted')]}"/>
                    <button name="action_reject" string="Reject" type="object" states="submitted" groups="hr_timesheet.group_timesheet_manager,hr.group_hr_manager" attrs="{'invisible': [('state', '!=', 'submitted')]}"/>
                    <button name="action_set_to_draft" string="Set to Draft" type="object" states="rejected" attrs="{'invisible': [('state', '!=', 'rejected')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="department_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="month" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="year" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="total_hours" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Timesheet Lines">
                            <field name="line_ids" attrs="{'readonly': [('state', 'not in', ('draft', 'submitted'))]}">
                                <tree editable="bottom">
                                    <field name="date" readonly="1"/>
                                    <field name="project_id"/>
                                    <field name="task_id"/>
                                    <field name="description"/>
                                    <field name="hours" sum="Total"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_employee_monthly_timesheet_tree" model="ir.ui.view">
        <field name="name">employee.monthly.timesheet.tree</field>
        <field name="model">employee.monthly.timesheet</field>
        <field name="arch" type="xml">
            <tree string="Monthly Timesheets">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="month"/>
                <field name="year"/>
                <field name="total_hours"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'submitted'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_employee_monthly_timesheet_search" model="ir.ui.view">
        <field name="name">employee.monthly.timesheet.search</field>
        <field name="model">employee.monthly.timesheet</field>
        <field name="arch" type="xml">
            <search string="Search Monthly Timesheets">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="year"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Waiting Approval" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Month" name="group_by_month" context="{'group_by': 'month'}"/>
                    <filter string="Year" name="group_by_year" context="{'group_by': 'year'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Pivot View for Reporting -->
    <record id="view_employee_monthly_timesheet_pivot" model="ir.ui.view">
        <field name="name">employee.monthly.timesheet.pivot</field>
        <field name="model">employee.monthly.timesheet</field>
        <field name="arch" type="xml">
            <pivot string="Timesheet Analysis">
                <field name="department_id" type="row"/>
                <field name="employee_id" type="row"/>
                <field name="month" type="col"/>
                <field name="total_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_employee_monthly_timesheet" model="ir.actions.act_window">
        <field name="name">Monthly Timesheets</field>
        <field name="res_model">employee.monthly.timesheet</field>
        <field name="view_mode">tree,form,pivot</field>
        <field name="context">{'search_default_group_by_year': 1}</field>
    </record>
</odoo>
